NODE_ENV=development

# Supabase PostgreSQL runtime / transaction pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase direct PostgreSQL connection for migrations/bootstrap
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Upstash direct Redis TLS connection (must use rediss:// for TLS)
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_UPSTASH_HOST:6379

# Optional Upstash REST interface
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

API_PORT=3001

# Base64-encoded random 32-byte key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
DATA_ENCRYPTION_KEY=

# Long independent random secret, never reuse DATA_ENCRYPTION_KEY (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
PASSPORT_LOOKUP_PEPPER=
