{
  "name": "@visaflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc && concurrently -k \"tsc -w --preserveWatchOutput\" \"node --env-file=../../.env --watch dist/main.js\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "lint": "echo 'No lint specified for api'",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@visaflow/config": "workspace:*",
    "@visaflow/crypto": "workspace:*",
    "@visaflow/database": "workspace:*",
    "@visaflow/provider-core": "workspace:*",
    "@visaflow/shared-types": "workspace:*",
    "bullmq": "^5.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
