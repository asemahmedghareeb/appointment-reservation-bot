{
  "name": "@visaflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint specified for database'",
    "test": "echo 'No tests specified for database'",
    "prisma:generate": "prisma generate",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@visaflow/config": "workspace:*",
    "@visaflow/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "dotenv": "^16.4.7",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
